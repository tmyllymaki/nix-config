command = /run/current-system/sw/bin/fish

background-opacity = 1.00
background-blur-radius = 20
macos-non-native-fullscreen = visible-menu
mouse-hide-while-typing = true

# Empty values reset the configuration to the default value
font-family = "IoskeleyMono Nerd Font"
# font-family = "Monaspace Neon"
# font-family-bold = "Monaspace Xenon"
# font-family-italic = "Monaspace Neon"
# font-family-bold-italic = "Monaspace Krypton"
# The following are optional settings for more balanced font weight
# font-style = "Medium"  # Broken: Medium is a sub-family, not a style
# font-style-bold = "Bold"
# font-style-italic = "Italic"
# font-style-bold-italic = "Bold Italic"
font-size = 16

# mouse-scroll-multiplier = 0.5

# window-decoration = false
# window-padding-x = 8
# window-padding-y = 8

#theme = catppuccin-mocha
theme = dark:modus_vivendi,light:modus_operandi
#font-feature = -liga

